# StillOn local config. Copy to .env — never commit secrets.

# Frozen demo date so the caseload always matches the pitch.
STILLON_DESK_DATE=2026-09-09

# amazon.nova-lite-v1:0 is auto-enabled on new accounts and cheap.
# Switch to amazon.nova-pro-v1:0 after the playground works.
AWS_REGION=us-east-2
STILLON_MODEL_ID=amazon.nova-lite-v1:0

# Paste the Bedrock API key from Discover → API keys. Never commit this file.
# Short-term keys expire in hours. Generate a new one if night runs start failing auth.
AWS_BEARER_TOKEN_BEDROCK=

# 1 = Amazon Nova via Bedrock. Leave 0 to use the local demo model.
STILLON_USE_BEDROCK=1

# Public board → Lambda Function URL → AgentCore (IAM stays off the browser).
# Leave unset for a local demo. Tests force this off.
STILLON_USE_AGENTCORE=0
STILLON_SWEEP_URL=
STILLON_SWEEP_SECRET=
STILLON_AGENTCORE_ARN=arn:aws:bedrock-agentcore:us-east-2:750390206396:runtime/StillOn_StillOn-C6Gf1qBQlK
STILLON_RUNTIME_SESSION=stillon-harbor-light-desk-2026-09-09
